FROM nvidia/cuda:11.8.0-base-ubuntu22.04

ENV PYTHONUNBUFFERED=1 \
    VLLM_USE_V1=0 \
    CUDA_HOME=/usr/local/cuda-11.8 \
    TRITON_PTXAS_PATH=/usr/local/cuda-11.8/bin/ptxas \
    MAX_JOBS=8 \
    HF_HOME=/data/huggingface \
    TRANSFORMERS_CACHE=/data/huggingface \
    UPLOAD_FOLDER=/data/uploads \
    OUTPUT_FOLDER=/data/outputs \
    TEMP_FOLDER=/data/temp

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    git \
    curl \
    ca-certificates \
    build-essential \
    ninja-build \
    cuda-nvcc-11-8 \
    cuda-cudart-dev-11-8 \
    python3 \
    python3-dev \
    python3-pip \
    python-is-python3 \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

ENV PATH=/usr/local/cuda-11.8/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda-11.8/lib64:$LD_LIBRARY_PATH

COPY requirements.txt .
COPY wheels/ ./wheels/
RUN python -m pip install --upgrade pip setuptools wheel
RUN python -m pip install torch==2.6.0 torchvision==0.21.0 torchaudio==2.6.0 --index-url https://download.pytorch.org/whl/cu118
RUN if [ -f wheels/vllm-0.8.5+cu118-cp38-abi3-manylinux1_x86_64.whl ]; then \
        python -m pip install wheels/vllm-0.8.5+cu118-cp38-abi3-manylinux1_x86_64.whl; \
    else \
        python -m pip install https://github.com/vllm-project/vllm/releases/download/v0.8.5/vllm-0.8.5+cu118-cp38-abi3-manylinux1_x86_64.whl; \
    fi
RUN python -m pip install -r requirements.txt
RUN if [ -f wheels/flash_attn-2.7.3+cu11torch2.6cxx11abiFALSE-cp310-cp310-linux_x86_64.whl ]; then \
        python -m pip install wheels/flash_attn-2.7.3+cu11torch2.6cxx11abiFALSE-cp310-cp310-linux_x86_64.whl; \
    else \
        python -m pip install flash-attn==2.7.3 --no-build-isolation; \
    fi

COPY . .

RUN mkdir -p /data/uploads /data/outputs /data/temp /data/huggingface

EXPOSE 5000

CMD ["python", "ocr_api.py"]
